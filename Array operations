#include <stdio.h>

#define MAX 10

int array[MAX];
int size = 0;

void display() {
    for (int i = 0; i < size; i++) {
        printf("%d ", array[i]);
    }
    printf("\n");
}

void insert(int pos, int value) {
    if (size >= MAX || pos < 0 || pos > size) {
        return;
    }
    for (int i = size; i > pos; i--) {
        array[i] = array[i - 1];
    }
    array[pos] = value;
    size++;
}

void delete(int pos) {
    if (size <= 0 || pos < 0 || pos >= size) {
        return;
    }
    for (int i = pos; i < size - 1; i++) {
        array[i] = array[i + 1];
    }
    size--;
}

int search(int value) {
    for (int i = 0; i < size; i++) {
        if (array[i] == value) {
            return i;
        }
    }
    return -1;
}

int main() {
    insert(0, 10);
    insert(1, 20);
    insert(2, 30);
    insert(1, 15);
    display();

    delete(2);
    display();

    printf("Found 30 at index: %d\n", search(30));

    return 0;
}
