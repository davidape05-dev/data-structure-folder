#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void init() {
    for (int i = 0; i < SIZE; i++) {
        hashTable[i] = -1;
    }
}

int hash(int key) {
    return key % SIZE;
}

void insert(int key) {
    int index = hash(key);

    while (hashTable[index] != -1) {
        printf("Collision at index %d for key %d! Moving to next...\n", index, key);
        index = (index + 1) % SIZE;
    }

    hashTable[index] = key;
    printf("Inserted %d at index %d\n", key, index);
}

int search(int key) {
    int index = hash(key);
    int start = index;

    while (hashTable[index] != -1) {
        if (hashTable[index] == key) {
            return index;
        }
        index = (index + 1) % SIZE;
        
        if (index == start) break;
    }
    return -1;
}

int main() {
    init();

    insert(12);
    insert(25);
    insert(22);

    printf("\nSearching for 22... Found at index: %d\n", search(22));
    printf("Searching for 99... Found at index: %d\n", search(99));

    return 0;
}
